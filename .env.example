# Local Postgres (docker-compose provides this out of the box)
DATABASE_URL="postgresql://novaos:novaos@localhost:5432/novaos?schema=public"

# Session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe - only needed once you wire up live payments (not required to run locally)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
