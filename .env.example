# Local Postgres (docker-compose provides this out of the box)
DATABASE_URL="postgresql://novaos:novaos@localhost:5432/novaos?schema=public"

# Session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Encrypts customer BYOAI provider keys at rest (AES-256-GCM) - required
# before anyone can connect their own AI provider in Settings. Generate with:
# openssl rand -base64 32
# Losing this key makes every stored BYOAI key permanently undecryptable.
ENCRYPTION_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI features (Marketing AI, Nova AI Assistant) - required for those two modules only
ANTHROPIC_API_KEY=""

# Stripe - real Connect integration, see src/services/stripe.ts. Leave blank to
# keep using the local payment stub; set both to go live (test mode keys first).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe subscription billing (TAKTCO charging its own customers) - create
# three recurring Prices in the Stripe Dashboard (Starter/Pro/Corporate,
# monthly) first, then paste their price IDs here. Required for Settings →
# Billing to work; without these, subscribing returns a clear "not configured"
# error rather than failing silently.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_CORPORATE=""

# Object storage (Cloudflare R2 preferred, S3-compatible fallback) - see
# src/lib/storage.ts. Leave all four blank to keep using base64-in-database.
# R2: STORAGE_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com
# S3:  leave STORAGE_ENDPOINT blank, set STORAGE_REGION to your AWS region
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""

# Resend - real email delivery, see src/services/resend.ts. Leave blank and
# emails log to EmailLog as FAILED instead of sending (visible in-product,
# nothing crashes).
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="TAKTCO <onboarding@resend.dev>"

# Twilio - real SMS delivery, see src/services/twilio.ts. Same fail-open
# logging behavior as Resend above when left blank.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Protects /api/automations/process-scheduled - set this and pass it as the
# x-cron-secret header from whatever scheduler calls that endpoint (e.g.
# Railway's cron plugin) to run DELAY automation steps.
CRON_SECRET=""

# Configured only, not implemented yet (see README §5) - safe to leave blank
OPENAI_API_KEY=""
