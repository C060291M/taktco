generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SALES_REP
  FIELD_TECH
}

enum LeadStage {
  NEW_LEAD
  CONTACTED
  ESTIMATE_SENT
  WON
  LOST
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum CommunicationType {
  CALL
  TEXT
  EMAIL
  NOTE
}

enum PhotoType {
  BEFORE
  AFTER
  PROGRESS
}

// A tenant. Every other table hangs off companyId.
model Company {
  id                   String   @id @default(cuid())
  name                 String
  subdomain            String   @unique
  logoUrl              String?
  brandPrimaryColor    String   @default("#0E0F11")
  brandAccentColor     String   @default("#3B82F6")
  tradeType             String?
  subscriptionTier     String   @default("starter") // starter | growth | pro
  stripeCustomerId     String?
  stripeConnectAccountId String?
  payoutsEnabled       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users         User[]
  customers     Customer[]
  leads         Lead[]
  communications Communication[]
  estimates     Estimate[]
  jobs          Job[]
  invoices      Invoice[]
  payments      Payment[]
  auditLogs     AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(FIELD_TECH)
  phone        String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  assignedLeads Lead[]        @relation("AssignedUser")
  communications Communication[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  source    String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leads          Lead[]
  communications Communication[]
  estimates      Estimate[]
  jobs           Job[]
  invoices       Invoice[]

  @@index([companyId])
}

model Lead {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pipelineStage  LeadStage @default(NEW_LEAD)
  assignedUserId String?
  assignedUser   User?     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  source         String?
  notes          String?
  createdAt      DateTime  @default(now())
  nextFollowupAt DateTime?

  @@index([companyId])
  @@index([pipelineStage])
}

model Communication {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  type       CommunicationType
  content    String
  createdAt  DateTime          @default(now())

  @@index([companyId])
  @@index([customerId])
}

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         EstimateStatus @default(DRAFT)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  lineItems      Json           @default("[]")
  approvalToken  String         @unique @default(cuid())
  createdAt      DateTime       @default(now())
  approvedAt     DateTime?

  job Job?

  @@index([companyId])
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  estimateId      String?   @unique
  estimate        Estimate? @relation(fields: [estimateId], references: [id])
  status          JobStatus @default(SCHEDULED)
  startDate       DateTime?
  endDate         DateTime?
  assignedUserIds String[]  @default([])
  quotedCost      Decimal   @default(0) @db.Decimal(12, 2)
  actualCost      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  photos   JobPhoto[]
  invoices Invoice[]

  @@index([companyId])
}

model JobPhoto {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  type       PhotoType
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@index([jobId])
}

model Invoice {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId            String?
  job              Job?          @relation(fields: [jobId], references: [id])
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime?
  paymentLinkToken String        @unique @default(cuid())
  createdAt        DateTime      @default(now())

  payments Payment[]

  @@index([companyId])
}

model Payment {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Decimal  @db.Decimal(12, 2)
  method                String   @default("manual") // card | ach | manual
  stripePaymentIntentId String?
  status                String   @default("succeeded") // pending | succeeded | failed | refunded
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([companyId])
}
