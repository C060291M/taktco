generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  OWNER
  ADMIN
  SALES_REP
  FIELD_TECH
}

enum LeadStage {
  NEW_LEAD
  CONTACTED
  APPOINTMENT_SCHEDULED
  ESTIMATE_REQUESTED
  ESTIMATE_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum FollowUpType {
  CALL
  EMAIL
  SMS
  SITE_VISIT
  APPOINTMENT
  REMINDER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
}

enum JobStatus {
  SCHEDULED
  MATERIALS_ORDERED
  READY_TO_START
  IN_PROGRESS
  INSPECTION_REQUIRED
  ON_HOLD
  WAITING_ON_CUSTOMER
  WEATHER_DELAY
  PUNCH_LIST
  COMPLETE
  CLOSED
  ARCHIVED
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
  FINAL_BALANCE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
  ARCHIVED
}

enum CommunicationType {
  CALL
  TEXT
  EMAIL
  NOTE
}

enum PhotoType {
  BEFORE
  AFTER
  PROGRESS
  INSPECTION
  WARRANTY
  MISC
}

enum ContractType {
  SERVICE_AGREEMENT
  CONSTRUCTION_CONTRACT
  CHANGE_ORDER
  WARRANTY
  PAYMENT_AGREEMENT
  MAINTENANCE_AGREEMENT
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
}

enum MarketingPlatform {
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  BLOG
  NEWSLETTER
  EMAIL
  SMS
}

enum CampaignChannel {
  EMAIL
  SMS
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

// A tenant. Every other table hangs off companyId.
model Company {
  id                   String   @id @default(cuid())
  name                 String
  subdomain            String   @unique
  logoUrl              String?
  brandPrimaryColor    String   @default("#0E0F11")
  brandAccentColor     String   @default("#1EAEC4")
  dashboardTheme       String   @default("solid") // solid | gradient | grid
  tradeType             String?
  serviceArea          String?
  businessPhone        String?
  businessEmail        String?
  businessAddress      String?
  taxRate              Decimal? @db.Decimal(5, 2) // percent, e.g. 8.25
  subscriptionTier     String   @default("starter") // starter | pro | corporate
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?  // trialing | active | past_due | canceled | unpaid
  currentPeriodEnd     DateTime?
  stripeConnectAccountId String?
  verificationStatus   VerificationStatus @default(NOT_STARTED)

  // Estimate defaults - pre-fill new estimates instead of starting blank
  defaultMarkupPercent Decimal? @db.Decimal(5, 2)
  defaultLaborRate     Decimal? @db.Decimal(10, 2)
  defaultWarrantyText  String?
  defaultEstimateTerms String?

  // Invoice defaults
  defaultInvoiceDueDays Int?    @default(14)
  // Atomic counters for invoice/estimate numbering - incremented via
  // Prisma's atomic `increment` operator (a real DB-level atomic op, not a
  // read-then-write race). Replaces the old db.invoice.count()-based
  // numbering, which could reissue a duplicate number once deletion
  // exists (delete invoice #4, the next count-based number would collide
  // with it again). These counters only ever go up, even across deletions.
  nextInvoiceNumber  Int      @default(1)
  nextEstimateNumber Int      @default(1)
  nextLeadNumber     Int      @default(1)
  // Business Rules (Phase 9.5) - fed into the AI estimate prompt alongside
  // the Pricing Matrix. Deliberately a small, real set rather than a full
  // rate-multiplier engine (no commercial/residential/overtime/emergency
  // rate fields) - see phase report for what's deferred.
  minJobPrice           Decimal? @db.Decimal(12, 2)
  targetMarginPercent   Decimal? @db.Decimal(5, 2)
  mobilizationFee       Decimal? @db.Decimal(12, 2)
  fuelCharge            Decimal? @db.Decimal(12, 2)
  travelCharge          Decimal? @db.Decimal(12, 2)
  warrantyLengthMonths  Int?
  estimateExpirationEnabled Boolean @default(false)
  defaultEstimateValidDays  Int     @default(30)
  defaultLateFeePercent Decimal? @db.Decimal(5, 2)
  defaultDepositPercent Decimal? @db.Decimal(5, 2)
  invoiceFooterText    String?

  // Marketing profile - threaded into AI generation prompts
  brandVoice           String?  // e.g. "Professional", "Friendly", "Technical", "Marketing"
  targetAudience       String?
  googleReviewLink     String?

  // Appearance preference beyond brand color - sidebar density
  sidebarStyle         String   @default("expanded") // expanded | compact | icons_only
  legalBusinessName    String?
  payoutsEnabled       Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users         User[]
  customers     Customer[]
  leads         Lead[]
  communications Communication[]
  estimates     Estimate[]
  jobs          Job[]
  invoices      Invoice[]
  contracts     Contract[]
  leadSources   LeadSource[]
  tags          Tag[]
  notes         Note[]
  tasks         Task[]
  followUps     FollowUp[]
  attachments   Attachment[]
  addresses     Address[]
  payments      Payment[]
  auditLogs     AuditLog[]
  marketingContent MarketingContent[]
  campaigns     Campaign[]
  estimateTemplates EstimateTemplate[]
  contractTemplates ContractTemplate[]
  changeOrders  ChangeOrder[]
  dailyLogs     DailyLog[]
  punchListItems PunchListItem[]
  milestones    Milestone[]
  reviewRequests ReviewRequest[]
  reviews       Review[]
  referrals     Referral[]
  automationWorkflows AutomationWorkflow[]
  emailLogs     EmailLog[]
  smsLogs       SmsLog[]
  aiSettings    CompanyAiSettings?
  aiCreditWallet AiCreditWallet?
  aiUsageLogs   AiUsageLog[]
  creditPurchases CreditPurchase[]
  notifications  Notification[]
  errorLogs      ErrorLog[]
  jobQueueItems  JobQueueItem[]
  workspaceProfiles WorkspaceProfile[]
  insights       Insight[]
  pricingCategories PricingCategory[]
  pricingItems      PricingItem[]
  estimatingQuestions EstimatingQuestion[]
  commsSettings  CompanyCommsSettings?
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(FIELD_TECH)
  phone        String?
  isPlatformAdmin Boolean @default(false)
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  // Per-category overrides layered on top of the two master switches above -
  // {"NEW_LEAD": {"email": true, "sms": false}, ...}. A category not present
  // here inherits the master switch. Kept as JSON rather than one column per
  // category x channel to avoid a combinatorial schema explosion.
  notificationCategoryPrefs Json @default("{}")
  color        String?  // for crew/calendar visual distinction
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  assignedLeads Lead[]        @relation("AssignedUser")
  assignedCustomers Customer[] @relation("AssignedCustomer")
  authoredNotes Note[]
  ownedTasks    Task[]
  ownedFollowUps FollowUp[]
  uploadedAttachments Attachment[]
  communications Communication[]
  auditLogs     AuditLog[]
  authoredDailyLogs DailyLog[]
  assignedPunchListItems PunchListItem[]

  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  source    String?
  status    String   @default("active")
  flagged   Boolean  @default(false)
  flagReason String?
  vip       Boolean  @default(false)
  assignedUserId String?
  assignedUser   User? @relation("AssignedCustomer", fields: [assignedUserId], references: [id])
  lastContactAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leads          Lead[]
  communications Communication[]
  estimates      Estimate[]
  jobs           Job[]
  invoices       Invoice[]
  contracts      Contract[]
  addresses      Address[]
  notes          Note[]
  tasks          Task[]
  followUps      FollowUp[]
  attachments    Attachment[]
  tags           CustomerTag[]
  reviewRequests ReviewRequest[]
  reviews        Review[]
  referralsGiven Referral[] @relation("ReferringCustomer")

  @@index([companyId])
  @@index([status])
}

model Lead {
  id             String    @id @default(cuid())
  leadNumber     Int
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pipelineStage  LeadStage @default(NEW_LEAD)
  assignedUserId String?
  assignedUser   User?     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  source         String?
  leadSourceId   String?
  leadSource     LeadSource? @relation(fields: [leadSourceId], references: [id])
  notes          String?
  priority       Priority  @default(MEDIUM)
  estimatedValue Decimal?  @db.Decimal(12, 2)
  probability    Int?
  expectedCloseDate DateTime?
  createdAt      DateTime  @default(now())
  nextFollowupAt DateTime?

  tasks       Task[]

  @@unique([companyId, leadNumber])
  followUps   FollowUp[]
  attachments Attachment[]
  noteEntries Note[]
  referralSource Referral?

  @@index([companyId])
  @@index([pipelineStage])
}

model Communication {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  type       CommunicationType
  content    String
  createdAt  DateTime          @default(now())

  @@index([companyId])
  @@index([customerId])
}

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  estimateNumber String?
  // Soft delete, same pattern as Customer/Job/Invoice - an approved
  // estimate can be linked to a Job with no cascade rule, so a hard delete
  // would risk being blocked or destroying real downstream records.
  // Filtered out of active lists/lookups once set.
  deletedAt      DateTime?
  status         EstimateStatus @default(DRAFT)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  lineItems      Json           @default("[]")
  warranty       String?
  terms          String?
  aiGenerated    Boolean        @default(false)
  displayMode    String         @default("ITEMIZED") // ITEMIZED | SUMMARY
  validUntil     DateTime?
  approvalToken  String         @unique @default(cuid())
  createdAt      DateTime       @default(now())
  viewedAt       DateTime?
  approvedAt     DateTime?

  job Job?
  notes       Note[]
  attachments Attachment[]

  @@index([companyId])
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Soft delete, same pattern as Customer/Invoice - a Job has real
  // operational history hanging off it (daily logs, photos, punch list,
  // crew assignments) and invoices reference it with no cascade rule, so a
  // hard delete would either fail outright or silently destroy months of
  // real records. Filtered out of active lists/lookups once set.
  deletedAt       DateTime?
  estimateId      String?   @unique
  estimate        Estimate? @relation(fields: [estimateId], references: [id])
  status          JobStatus @default(SCHEDULED)
  startDate       DateTime?
  endDate         DateTime?
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?
  projectAddress  String?
  assignedUserIds String[]  @default([])
  projectManagerId String?
  quotedCost      Decimal   @default(0) @db.Decimal(12, 2)
  actualCost      Decimal   @default(0) @db.Decimal(12, 2)
  category        String?   // for Portfolio filtering, e.g. "Fencing", "Roofing"
  portfolioFeatured Boolean @default(false)
  portfolioHidden Boolean   @default(false) // privacy control - exclude from Portfolio even if photos exist
  createdAt       DateTime  @default(now())

  photos   JobPhoto[]
  invoices Invoice[]
  contracts Contract[]
  changeOrders ChangeOrder[]
  dailyLogs DailyLog[]
  punchListItems PunchListItem[]
  milestones Milestone[]
  notes Note[]
  attachments Attachment[]
  tasks Task[]
  reviewRequests ReviewRequest[]
  marketingContent MarketingContent[]

  @@index([companyId])
}

model JobPhoto {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  type       PhotoType
  caption    String?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  analysis   PhotoAnalysis?

  @@index([jobId])
}

model Invoice {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId            String?
  job              Job?          @relation(fields: [jobId], references: [id])
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber    String?
  // Soft delete, same pattern as Customer.deletedAt - a financial record,
  // never actually destroyed. Filtered out of active lists/counts once set.
  deletedAt        DateTime?
  amount           Decimal       @db.Decimal(12, 2)
  lineItems        Json          @default("[]")
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentTerms     String?
  notes            String?
  status           InvoiceStatus @default(DRAFT)
  issueDate        DateTime      @default(now())
  dueDate          DateTime?
  viewedAt         DateTime?
  kind             InvoiceKind   @default(STANDARD)
  pairedInvoiceId  String?
  paymentLinkToken String        @unique @default(cuid())
  createdAt        DateTime      @default(now())

  payments Payment[]

  @@index([companyId])
}

model Payment {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Decimal  @db.Decimal(12, 2)
  method                String   @default("manual") // card | ach | manual
  stripePaymentIntentId String?
  stripeCheckoutSessionId String?
  status                String   @default("succeeded") // pending | succeeded | failed | refunded | partially_refunded
  refundedAmount        Decimal  @default(0) @db.Decimal(12, 2)
  refundedAt            DateTime?
  stripeRefundId        String?
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
}

// Fillable/editable contracts (service agreements, change orders, warranties, etc.)
// plus an option to upload a company's own document instead of using a template.
// signedByName/signedAt is a typed-name e-signature stub, same pattern as the
// invoice payment stub - TODO before going live: swap for a real e-signature
// provider (e.g. HelloSign/DocuSign) if legally binding signatures are required.
model Contract {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId        String?
  job          Job?           @relation(fields: [jobId], references: [id])
  type         ContractType
  title        String
  content      String?        // fillable/editable template body
  fileUrl      String?        // uploaded document instead of (or alongside) the template - base64 for now, same storage TODO as logos
  fileName     String?
  status       ContractStatus @default(DRAFT)
  signedByName String?
  signedAt     DateTime?
  ipAddress    String?        // captured server-side at signing - part of the typed-signature audit trail, see stub note above
  signingToken String         @unique @default(cuid())
  createdAt    DateTime       @default(now())

  notes       Note[]
  attachments Attachment[]

  @@index([companyId])
}

model MarketingContent {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?              @relation(fields: [jobId], references: [id])
  platform  MarketingPlatform
  prompt    String
  content   String
  createdAt DateTime          @default(now())

  @@index([companyId])
}

enum CampaignAudienceType {
  ALL_CUSTOMERS
  ACTIVE_LEADS
  PAST_CUSTOMERS
  SPECIFIC_CUSTOMERS
}

model Campaign {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  channel        CampaignChannel
  audience       CampaignAudienceType @default(ALL_CUSTOMERS)
  // Only used when audience is SPECIFIC_CUSTOMERS - a plain array of
  // customer ids, chosen individually in the New Campaign form. Lets a
  // campaign be sent to exactly one or two customers for real testing,
  // instead of the whole audience every time.
  recipientCustomerIds Json      @default("[]")
  subject        String?
  message        String
  status         CampaignStatus  @default(DRAFT)
  recipientCount Int             @default(0)
  deliveredCount Int             @default(0)
  failedCount    Int             @default(0)
  queueItems     CampaignQueueItem[]
  sentAt         DateTime?
  // Soft delete, same consistent pattern as Customer/Job/Invoice/Estimate.
  // Nothing else references a Campaign, so a hard delete would be
  // technically safe here - kept soft anyway for a predictable, consistent
  // admin experience, and because the send stats are worth keeping as
  // real record-keeping history even after "deleting" one from active view.
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model LeadSource {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  leads Lead[]

  @@unique([companyId, name])
}

model Tag {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  customers CustomerTag[]

  @@unique([companyId, name])
}

model CustomerTag {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

// Unified notes for both Customers and Leads - exactly one of customerId/leadId is set,
// enforced at the API layer (Prisma can't express "exactly one of" as a DB constraint).
model Note {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  content    String
  pinned     Boolean  @default(false)
  private    Boolean  @default(false)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([leadId])
}

model Task {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime?
  priority   Priority @default(MEDIUM)
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id])
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([leadId])
}

model FollowUp {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       FollowUpType
  dueDate    DateTime
  priority   Priority       @default(MEDIUM)
  status     FollowUpStatus @default(PENDING)
  ownerId    String?
  owner      User?          @relation(fields: [ownerId], references: [id])
  notes      String?
  createdAt  DateTime       @default(now())

  @@index([companyId])
  @@index([dueDate])
}

model Attachment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  url        String
  fileName   String
  fileType   String?
  uploadedById String?
  uploadedBy   User?  @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model Address {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Service")
  line1      String
  city       String?
  state      String?
  zip        String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum ChangeOrderStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
}

model EstimateTemplate {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  tradeType         String?
  defaultLineItems  Json     @default("[]")
  defaultWarranty   String?
  defaultTerms      String?
  createdAt         DateTime @default(now())

  @@index([companyId])
}

model ContractTemplate {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      ContractType
  name      String
  content   String
  createdAt DateTime     @default(now())

  @@index([companyId])
}

// Price/scope adjustments against an in-progress Job, separate from the general
// Contract system since a change order needs to move the job's cost totals -
// approving one updates Job.quotedCost, which a generic signed document shouldn't do.
model ChangeOrder {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description  String
  amountDelta  Decimal           @db.Decimal(12, 2)
  status       ChangeOrderStatus @default(DRAFT)
  signedByName String?
  signedAt     DateTime?
  createdAt    DateTime          @default(now())

  @@index([companyId])
  @@index([jobId])
}

