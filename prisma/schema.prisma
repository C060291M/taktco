  category    NotificationCategory
  title       String
  body        String?
  // Where clicking the notification should go, e.g. "/customers/abc123" -
  // kept as a plain path rather than typed foreign keys so one model can
  // point at any entity in the system without a union of nullable relations.
  linkUrl     String?
  read        Boolean              @default(false)
