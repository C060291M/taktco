enum PhotoAnalysisType {
  PROGRESS_COMPARISON
  DAMAGE_DETECTION
  QUALITY_CONTROL
  SAFETY_OBSERVATION
  MATERIAL_TRACKING
}

enum PhotoAnalysisStatus {
  NOT_STARTED
  QUEUED
  COMPLETE
  FAILED
