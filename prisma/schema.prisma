// ---------- AI Credit System & BYOAI ----------

enum AiMode {
  NOVA_AI
  BYOAI
}

enum AiProviderName {
  ANTHROPIC
  OPENAI
  GOOGLE_GEMINI
  XAI
  AZURE_OPENAI
}

// Lets a company use their OWN Resend/Twilio accounts instead of TAKTCO's
// shared platform ones (same reasoning as BYOAI: on the shared setup, a
// company's own AI provider key overrides the platform default). Same
// AES-256-GCM encryption pattern as CompanyAiSettings.encryptedApiKey - see
// lib/crypto.ts. Both providers are optional and independent of each other.
model CompanyCommsSettings {
  id                      String    @id @default(cuid())
  companyId               String    @unique
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Simplest path: direct Gmail/Outlook via SMTP + an app password - no
  // separate Resend account needed. "GMAIL" or "OUTLOOK" picks the right
  // SMTP host/port automatically; smtpUser is their real email address.
  smtpProvider            String?   // GMAIL | OUTLOOK
  smtpUser                String?
  encryptedSmtpPassword   String?   // an app password, never their real login password
  smtpFromName            String?
  smtpConnectionStatus    String?   @default("untested")
  // Advanced/alternate path for companies that already have their own Resend.
  encryptedResendApiKey   String?
  resendFromAddress       String?
  resendConnectionStatus  String?   @default("untested")
  twilioAccountSid        String?
  encryptedTwilioAuthToken String?
  twilioFromNumber        String?
  twilioConnectionStatus  String?   @default("untested")
  callMarksContacted      Boolean  @default(false)
  updatedAt               DateTime  @updatedAt
}

model CompanyAiSettings {
  id              String          @id @default(cuid())
  companyId       String          @unique
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mode            AiMode          @default(NOVA_AI)
  byoaiProvider   AiProviderName?
  byoaiModel      String?
  // AES-256-GCM ciphertext (iv:authTag:ciphertext, all hex) - see lib/crypto.ts.
  // Never store or log the plaintext key anywhere, including here.
  encryptedApiKey String?
  connectionStatus String?        @default("untested") // untested | connected | failed
  lastTestedAt    DateTime?
  updatedAt       DateTime        @updatedAt
}

model AiCreditWallet {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  includedCredits  Int      @default(500) // reset to the tier's amount every cycle
  purchasedCredits Int      @default(0)   // never expires, never reset
  usedThisCycle    Int      @default(0)
  cycleResetAt     DateTime
  updatedAt        DateTime @updatedAt
}

model CreditPackage {
  id         String  @id @default(cuid())
  name       String
  credits    Int
  priceCents Int
  active     Boolean @default(true)
}

// Admin-configurable credit cost per feature - "Credit values must be
// configurable by Admin" from the spec. Platform-wide, not per-company.
model AiFeatureCost {
  id       String @id @default(cuid())
  feature  String @unique // "quick_question" | "email_draft" | "estimate_builder" | "contract_builder" | "marketing_post" | "business_analysis"
  credits  Int
}

model AiUsageLog {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mode          AiMode
  provider      AiProviderName
  model         String
  feature       String
  creditsUsed   Int             @default(0) // 0 for BYOAI - the company pays their own provider directly
  responseTimeMs Int?
  status        String          // success | failed
  errorMessage  String?
  estimatedCostCents Int?       // Nova AI mode only - our estimated provider cost, for margin tracking
  createdAt     DateTime        @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model CreditPurchase {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  packageId     String?
  credits       Int
  priceCents    Int
  stripeCheckoutSessionId String?
  status        String   @default("pending") // pending | completed | failed
  createdAt     DateTime @default(now())

  @@index([companyId])
}

// ---------- Global Notification Center ----------

enum NotificationCategory {
  NEW_LEAD
  ESTIMATE_VIEWED
  ESTIMATE_APPROVED
  CONTRACT_SIGNED
  CONTRACT_DECLINED
  INVOICE_SENT
  INVOICE_PAID
