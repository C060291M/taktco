// ---------- Automation Engine (rule-based; DB shape is canvas-ready) ----------
// Trigger/condition/action are stored generically (type + JSON config) so a future
// visual drag-and-drop builder is purely a new UI over this same schema and
// lib/automationEngine.ts - no backend changes needed when that's built.

enum AutomationTrigger {
  LEAD_CREATED
  CUSTOMER_CREATED
  ESTIMATE_SENT
  ESTIMATE_APPROVED
  CONTRACT_SIGNED
  PROJECT_STARTED
  PROJECT_COMPLETED
  INVOICE_SENT
  INVOICE_PAID
  REVIEW_RECEIVED
  REFERRAL_RECEIVED
  WARRANTY_EXPIRING
  TASK_OVERDUE
  PROJECT_DELAYED
  INVOICE_OVERDUE
}

enum AutomationActionType {
  SEND_EMAIL
  SEND_SMS
  CREATE_TASK
  CREATE_FOLLOWUP
  ASSIGN_EMPLOYEE
  GENERATE_AI_CONTENT
  NOTIFY_USER
  MOVE_PIPELINE_STAGE
  UPDATE_PROJECT
  DELAY
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model AutomationWorkflow {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  trigger     AutomationTrigger
  conditions  Json              @default("[]") // [{ field, operator, value }]
  enabled     Boolean           @default(true)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  actions     AutomationAction[]
  runLogs     AutomationRunLog[]
  scheduled   AutomationScheduledAction[]

  @@index([companyId])
  @@index([trigger])
}

model AutomationAction {
  id         String               @id @default(cuid())
  workflowId String
  workflow   AutomationWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order      Int
  type       AutomationActionType
  config     Json                 @default("{}") // shape depends on type, e.g. {"days": 7} for DELAY, {"message": "..."} for SEND_SMS
  createdAt  DateTime             @default(now())

  @@index([workflowId])
}

// A DELAY action can't block a web request, so it's persisted here and picked up
// by a scheduled job (see /api/automations/process-scheduled - needs a real cron
// trigger, e.g. Railway's cron plugin, to call it on an interval in production).
model AutomationScheduledAction {
  id           String             @id @default(cuid())
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  companyId    String
  fromActionIndex Int             // resume the action list at this index once due
  context      Json               // the trigger context, preserved for when it resumes
  runAt        DateTime
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([companyId])
  @@index([runAt])
}

model AutomationRunLog {
  id         String               @id @default(cuid())
  companyId  String
  workflowId String
  workflow   AutomationWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  trigger    AutomationTrigger
  status     AutomationRunStatus
  summary    String?
  context    Json                 @default("{}")
  ranAt      DateTime             @default(now())

  @@index([companyId])
  @@index([workflowId])
}

