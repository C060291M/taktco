  @@index([companyId])
  @@index([module])
  @@index([severity])
  @@index([createdAt])
}

// ---------- Background Job Queue ----------
// DB-backed rather than Redis/BullMQ - consistent with the AutomationScheduledAction
// pattern already in use (see lib/automationEngine.ts) and needs no new
// infrastructure. Processed by a cron-callable endpoint, same as that system -
// a real message broker is the right upgrade once volume justifies it, not before.

enum JobQueueStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum JobQueueType {
  EMAIL_DELIVERY
  SMS_DELIVERY
  REVIEW_REQUEST
  REFERRAL_PROCESSING
  CAMPAIGN_SEND
  AI_GENERATION
  REPORT_GENERATION
  AUTOMATION_PROCESSING
}

model JobQueueItem {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        JobQueueType
  payload     Json           @default("{}")
  status      JobQueueStatus @default(QUEUED)
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  lastError   String?
  runAt       DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([companyId])
  @@index([status])
  @@index([runAt])
}

// ---------- Dashboard Customization & Workspace Profiles ----------
// Real, shippable version of "dashboard customization": which widgets show,
// per named profile, switchable with one click. NOT drag-and-drop/resize/pin -
// that remains a deferred, larger UI investment (see README). This still
// delivers the core value ("one click switches the entire dashboard").

model WorkspaceProfile {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String   // profiles are per-user, not shared across the company
  name        String
  visibleWidgets Json  @default("[]") // array of widget keys, e.g. ["revenue","pipeline","tasks"]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

// ---------- Predictive Alerts / Smart Recommendations ----------
// Rule-based, not ML - every insight is generated by an explainable business
// rule (see lib/insightsEngine.ts), never a fabricated confidence percentage.
// "ruleKey" + "ruleExplanation" together power the "Why am I seeing this?" UI.

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InsightCategory {
  PROJECT_RISK
  INVOICE_RISK
  CUSTOMER_RISK
  ESTIMATE_QUALITY
  SALES_OPPORTUNITY
  FINANCIAL
}

model Insight {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    InsightCategory
  severity    InsightSeverity @default(MEDIUM)
  title       String
  body        String?
  ruleKey     String          // e.g. "invoice_due_soon", "project_past_target" - the exact rule that fired
  ruleExplanation String      // plain-language explanation shown behind "Why am I seeing this?"
  linkUrl     String?
  recommendedAction String?
  dismissed   Boolean         @default(false)
  dismissedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([companyId])
  @@index([companyId, dismissed])
}

// ---------- Photo Intelligence (architecture only - no computer vision yet) ----------
